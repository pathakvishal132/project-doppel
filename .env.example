# Copy to .env (never commit .env) and export before running:  set -a; source .env; set +a
DB_URL=jdbc:postgresql://localhost:5432/doppel
DB_USERNAME=doppel
DB_PASSWORD=change-me

# Secret key for HMAC-SHA256 of registrant account numbers. Use a long random value, e.g. `openssl rand -hex 32`.
DOPPEL_HMAC_SECRET=change-me-to-a-long-random-secret

SERVER_PORT=8080
